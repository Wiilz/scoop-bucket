{
    "version": "18.0d1e1.0",
    "description": "Apple's SF Mono font patched with the Nerd Fonts patcher",
    "homepage": "https://github.com/epk/SF-Mono-Nerd-Font",
    "license": "MIT",
    "url": "https://github.com/epk/SF-Mono-Nerd-Font/archive/refs/tags/v18.0d1e1.0.zip",
    "hash": "8d69d7fa7404c59dad161c363c928bab2010aa1f1489642b6e035ca4b4094294",
    "extract_dir": "SF-Mono-Nerd-Font-18.0d1e1.0",
    "installer": {
        "script": [
            "$currentBuildNumber = [int] (Get-ItemProperty \"HKLM:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\").CurrentBuildNumber",
            "if ($currentBuildNumber -lt 17763 -and !$global) {",
            "    throw \"Per-user fonts require Windows 10 1809 or later. On older Windows, use 'scoop install -g $app' from an elevated shell.\"",
            "}",
            "$fontNames = @('Bold', 'Heavy', 'Light', 'Medium', 'Regular', 'Semibold') | ForEach-Object { \"SFMono $_ Nerd Font Complete.otf\"; \"SFMono $_ Italic Nerd Font Complete.otf\" }",
            "foreach ($fontName in $fontNames) {",
            "    if (!(Test-Path -LiteralPath (Join-Path $dir $fontName) -PathType Leaf -ErrorAction Stop)) { throw \"Missing font in archive: $fontName\" }",
            "}",
            "$fontInstallDir = if ($global) { \"$env:windir\\Fonts\" } else { \"$env:LOCALAPPDATA\\Microsoft\\Windows\\Fonts\" }",
            "if (!$global) {",
            "    # Same user-font directory ACL fix as scoop-nerd-fonts; no Windows 11 global-install restriction.",
            "    # https://github.com/matthewjberger/scoop-nerd-fonts/issues/198#issuecomment-1488996737",
            "    New-Item -Path $fontInstallDir -ItemType Directory -Force -ErrorAction Stop | Out-Null",
            "    $accessControlList = Get-Acl -LiteralPath $fontInstallDir -ErrorAction Stop",
            "    foreach ($sid in @('S-1-15-2-1', 'S-1-15-2-2')) {",
            "        $rule = [System.Security.AccessControl.FileSystemAccessRule]::new([System.Security.Principal.SecurityIdentifier]::new($sid), 'ReadAndExecute', 'ContainerInherit,ObjectInherit', 'None', 'Allow')",
            "        $accessControlList.SetAccessRule($rule)",
            "    }",
            "    Set-Acl -LiteralPath $fontInstallDir -AclObject $accessControlList -ErrorAction Stop",
            "}",
            "$registryRoot = if ($global) { \"HKLM\" } else { \"HKCU\" }",
            "$registryKey = \"${registryRoot}:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Fonts\"",
            "if (!(Test-Path -LiteralPath $registryKey -ErrorAction Stop)) { New-Item -Path $registryKey -Force -ErrorAction Stop | Out-Null }",
            "foreach ($fontName in $fontNames) {",
            "    $fontPath = Join-Path $fontInstallDir $fontName",
            "    $value = if ($global) { $fontName } else { $fontPath }",
            "    Copy-Item -LiteralPath (Join-Path $dir $fontName) -Destination $fontPath -Force -ErrorAction Stop",
            "    New-ItemProperty -LiteralPath $registryKey -Name ([System.IO.Path]::GetFileNameWithoutExtension($fontName) + ' (TrueType)') -Value $value -Force -ErrorAction Stop | Out-Null",
            "}"
        ]
    },
    "pre_uninstall": [
        "# Keep the caller's installation scope; affected Scoop versions misbind -Global in Invoke-Installer.",
        "$fontInstallDir = if ($global) { \"$env:windir\\Fonts\" } else { \"$env:LOCALAPPDATA\\Microsoft\\Windows\\Fonts\" }",
        "$registryRoot = if ($global) { \"HKLM\" } else { \"HKCU\" }",
        "$registryKey = \"${registryRoot}:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Fonts\"",
        "Write-Host \"Removing $(if ($global) { 'global' } else { 'per-user' }) fonts from '$fontInstallDir' ($registryRoot).\"",
        "# Exact archive filenames: cleanup also works after partial installation or source-file loss.",
        "$fontNames = @('Bold', 'Heavy', 'Light', 'Medium', 'Regular', 'Semibold') | ForEach-Object { \"SFMono $_ Nerd Font Complete.otf\"; \"SFMono $_ Italic Nerd Font Complete.otf\" }",
        "$fonts = @(foreach ($fontName in $fontNames) {",
        "    $fontPath = Join-Path $fontInstallDir $fontName",
        "    $registryName = [System.IO.Path]::GetFileNameWithoutExtension($fontName) + ' (TrueType)'",
        "    $entry = $null",
        "    if (Test-Path -LiteralPath $registryKey -ErrorAction Stop) {",
        "        $entry = (Get-ItemProperty -LiteralPath $registryKey -ErrorAction Stop).PSObject.Properties[$registryName]",
        "    }",
        "    $expectedValue = if ($global) { $fontName } else { $fontPath }",
        "    if ($entry -and $entry.Value -ne $expectedValue) { throw \"Font registry entry '$registryName' points elsewhere; refusing to remove it.\" }",
        "    [pscustomobject]@{ Path = $fontPath; RegistryName = $registryName; Registered = [bool]$entry }",
        "})",
        "if (-not ('LzScoop.SFMonoNative' -as [type])) {",
        "    Add-Type -TypeDefinition @'",
        "using System;",
        "using System.Runtime.InteropServices;",
        "namespace LzScoop {",
        "    public static class SFMonoNative {",
        "        [DllImport(\"gdi32.dll\", CharSet = CharSet.Unicode, ExactSpelling = true)]",
        "        [return: MarshalAs(UnmanagedType.Bool)]",
        "        public static extern bool RemoveFontResourceExW(string name, uint flags, IntPtr reserved);",
        "        [DllImport(\"user32.dll\", ExactSpelling = true, SetLastError = true)]",
        "        [return: MarshalAs(UnmanagedType.Bool)]",
        "        public static extern bool SendNotifyMessageW(IntPtr hWnd, uint msg, UIntPtr wParam, IntPtr lParam);",
        "    }",
        "}",
        "'@ -ErrorAction Stop",
        "}",
        "# Unregister first so Windows will not reload the fonts at the next login.",
        "foreach ($font in $fonts) {",
        "    if ($font.Registered) { Remove-ItemProperty -LiteralPath $registryKey -Name $font.RegistryName -Force -ErrorAction Stop }",
        "}",
        "# https://learn.microsoft.com/windows/win32/api/wingdi/nf-wingdi-removefontresourceexw",
        "foreach ($font in $fonts) {",
        "    while ([LzScoop.SFMonoNative]::RemoveFontResourceExW($font.Path, 0, [IntPtr]::Zero)) { }",
        "}",
        "if (-not [LzScoop.SFMonoNative]::SendNotifyMessageW([IntPtr]0xffff, 0x001d, [UIntPtr]::Zero, [IntPtr]::Zero)) {",
        "    Write-Warning 'Could not broadcast the font change. Restart applications that cache fonts.'",
        "}",
        "$cleanupErrors = @()",
        "foreach ($font in $fonts) {",
        "    try {",
        "        if (Test-Path -LiteralPath $font.Path -ErrorAction Stop) {",
        "            Remove-Item -LiteralPath $font.Path -Force -ErrorAction Stop",
        "            if (Test-Path -LiteralPath $font.Path -ErrorAction Stop) { throw 'Font file is still present after deletion.' }",
        "        }",
        "    } catch {",
        "        $cleanupErrors += \"$($font.Path): $($_.Exception.Message)\"",
        "    }",
        "}",
        "if ($cleanupErrors.Count) {",
        "    throw (\"Font registrations have been removed, but file cleanup is incomplete. Close applications using these fonts, or restart Windows, then run 'scoop uninstall $(if ($global) { '-g ' })$app' again. Do not reinstall before cleanup. If it still fails, check file permissions. Details: \" + ($cleanupErrors -join '; '))",
        "}",
        "if ($cmd -eq 'uninstall') {",
        "    Write-Host \"The 'SF Mono Nerd Font' files and registry entries have been removed. Restart applications that cache fonts.\" -Foreground Magenta",
        "}"
    ],
    "checkver": {
        "url": "https://api.github.com/repos/epk/SF-Mono-Nerd-Font/releases/latest",
        "jsonpath": "$.name",
        "regex": "v([\\d.\\w]+)"
    },
    "autoupdate": {
        "url": "https://github.com/epk/SF-Mono-Nerd-Font/archive/refs/tags/v$version.zip",
        "extract_dir": "SF-Mono-Nerd-Font-$version"
    }
}
