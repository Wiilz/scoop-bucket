{
    "version": "0.9.84",
    "description": "面向人类与 AI 协作的纯文本工作区，支持 Markdown 所见即所得编辑、多格式预览和 MCP 集成",
    "homepage": "https://github.com/xiaolai/vmark",
    "license": "ISC",
    "notes": [
        "依赖 WebView2 Runtime（Windows 11 通常已内置，缺失时需另行安装）。",
        "直接解压官方安装包，不运行安装器，不自动注册文件关联；保留 MCP 服务和工作流资源。",
        "请使用 scoop update vmark 管理版本，不使用应用内升级；更新或卸载前保存文档并从托盘完整退出，同时关闭仍在使用 VMark MCP 服务的客户端。",
        "安装和更新保留 %APPDATA%\\app.vmark 和 %LOCALAPPDATA%\\app.vmark；执行 scoop uninstall vmark 时会删除当前用户的这两个目录（包括设置、会话恢复和 WebView2 数据），无需 -p，请提前备份。",
        "不清理用户另存的文档、Windows 凭据或其他客户端的 MCP 配置；不提供自动备份，也不声明 persist。旧安装需刷新 manifest 快照后清理才会生效，详见 docs/vmark.md。"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/xiaolai/vmark/releases/download/v0.9.84/VMark_0.9.84_x64-setup.exe#/dl.7z",
            "hash": "3339f2884fe4a9c72a91a0ae8cde718176f4b0b3a8431853350d594986c7c4b9"
        }
    },
    "pre_install": "Remove-Item -LiteralPath \"$dir\\`$PLUGINSDIR\", \"$dir\\uninstall.exe\" -Recurse -Force",
    "post_uninstall": [
        "if ($cmd -eq 'uninstall') {",
        "    foreach ($root in @($env:APPDATA, $env:LOCALAPPDATA)) {",
        "        if ([string]::IsNullOrWhiteSpace($root) -or ![IO.Path]::IsPathRooted($root)) {",
        "            Write-Warning 'Skipping VMark data cleanup: AppData path is missing or not absolute.'",
        "            continue",
        "        }",
        "        $dataPath = Join-Path $root 'app.vmark'",
        "        if (Test-Path -LiteralPath $dataPath) {",
        "            $item = Get-Item -LiteralPath $dataPath -Force -ErrorAction Stop",
        "            if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) {",
        "                Write-Warning \"Skipping linked VMark data directory: $dataPath\"",
        "                continue",
        "            }",
        "            Remove-Item -LiteralPath $dataPath -Recurse -Force -ErrorAction Stop",
        "        }",
        "    }",
        "}"
    ],
    "bin": "vmark.exe",
    "shortcuts": [
        [
            "vmark.exe",
            "VMark"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/xiaolai/vmark/releases/download/v$version/VMark_$version_x64-setup.exe#/dl.7z"
            }
        }
    }
}
