    "post_install": [
        "if (Test-Path \"$dir\\current\") {",
        "    Copy-Item \"$dir\\current\\*\" \"$dir\" -Recurse -Force",
        "    Remove-Item \"$dir\\current\" -Recurse -Force",
        "}",
        "Remove-Item \"$dir\\Update.exe\" -Force -ErrorAction SilentlyContinue",
        "Remove-Item \"$dir\\packages\" -Recurse -Force -ErrorAction SilentlyContinue",
        "$dataDst = \"$env:LOCALAPPDATA\\Redisee\\Data\"",
        "if (Test-Path \"$persist_dir\\Data\\connections.db\") {",
        "    if (-not (Test-Path \"$dataDst\\connections.db\")) {",
        "        New-Item -ItemType Directory -Force -Path \"$dataDst\" | Out-Null",
        "        Copy-Item \"$persist_dir\\Data\\*\" \"$dataDst\" -Force",
        "        Write-Host \"Migrated existing Redisee data to $dataDst\" -ForegroundColor Green",
        "    }",
        "}"
    ],
    "bin": "Redisee.exe",
    "shortcuts": [
        [
            "Redisee.exe",
            "Redisee"
        ]
    ],
    "checkver": {
        "github": "https://github.com/tiny-craft/redisee-app",
        "regex": "/releases/tag/v?([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/tiny-craft/redisee-app/releases/download/v$version/Redisee-win-x64-stable-Portable.zip"
