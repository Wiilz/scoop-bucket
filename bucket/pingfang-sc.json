{
    "version": "20.0d4e1-static",
    "description": "PingFang SC OpenType font family for Windows",
    "homepage": "https://github.com/ACT-02/PingFang-for-Windows",
    "license": {
        "identifier": "Proprietary",
        "url": "https://github.com/ACT-02/PingFang-for-Windows"
    },
    "url": [
        "https://raw.githubusercontent.com/ACT-02/PingFang-for-Windows/20.0d4e1-static/PingFangSC-Light.otf",
        "https://raw.githubusercontent.com/ACT-02/PingFang-for-Windows/20.0d4e1-static/PingFangSC-Medium.otf",
        "https://raw.githubusercontent.com/ACT-02/PingFang-for-Windows/20.0d4e1-static/PingFangSC-Regular.otf",
        "https://raw.githubusercontent.com/ACT-02/PingFang-for-Windows/20.0d4e1-static/PingFangSC-Semibold.otf",
        "https://raw.githubusercontent.com/ACT-02/PingFang-for-Windows/20.0d4e1-static/PingFangSC-Thin.otf",
        "https://raw.githubusercontent.com/ACT-02/PingFang-for-Windows/20.0d4e1-static/PingFangSC-Ultralight.otf"
    ],
    "hash": [
        "ab54e9753f9ea8999d76a7a0cfe14f264bc1b132d1d5717c8e6bb304ffe2ea79",
        "179302d57a37ace157a724e07d38acb5365f1bc16eb48eaa9ec63ff385f9e50e",
        "f3211fb7a144834c1694856fddd38b21bc7e313f096d14c3ac47f49b69aefba2",
        "b27e74e2fcd0ce56327b23c8fa04d495f98837646670e1e3700afdeea1aaf681",
        "53f05c168a17f85d915e57168b97cf31522e2d2654280b99b68cd6a30cae4687",
        "6041db10d5099fb3e405a7a6a72514d641d2d9255bbd3d1e629cbdddc2c205b0"
    ],
    "installer": {
        "script": [
            "$currentBuildNumber = [int] (Get-ItemProperty \"HKLM:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\").CurrentBuildNumber",
            "$windows10Version1809BuildNumber = 17763",
            "$isPerUserFontInstallationSupported = $currentBuildNumber -ge $windows10Version1809BuildNumber",
            "if (!$isPerUserFontInstallationSupported -and !$global) {",
            "    scoop uninstall $app",
            "    Write-Host \"\"",
            "    Write-Host \"For Windows version before Windows 10 Version 1809 (OS Build 17763),\" -Foreground DarkRed",
            "    Write-Host \"Font can only be installed for all users.\" -Foreground DarkRed",
            "    Write-Host \"\"",
            "    Write-Host \"Please use following commands to install '$app' Font for all users.\" -Foreground DarkRed",
            "    Write-Host \"\"",
            "    Write-Host \"        scoop install sudo\"",
            "    Write-Host \"        sudo scoop install -g $app\"",
            "    Write-Host \"\"",
            "    exit 1",
            "}",
            "$fontInstallDir = if ($global) { \"$env:windir\\Fonts\" } else { \"$env:LOCALAPPDATA\\Microsoft\\Windows\\Fonts\" }",
            "if (-not $global) {",
            "    # Ensure user font install directory exists and has correct permission settings",
            "    # See https://github.com/matthewjberger/scoop-nerd-fonts/issues/198#issuecomment-1488996737",
            "    New-Item $fontInstallDir -ItemType Directory -ErrorAction SilentlyContinue | Out-Null",
            "    $accessControlList = Get-Acl $fontInstallDir",
            "    $allApplicationPackagesAccessRule = New-Object System.Security.AccessControl.FileSystemAccessRule([System.Security.Principal.SecurityIdentifier]::new(\"S-1-15-2-1\"), \"ReadAndExecute\", \"ContainerInherit,ObjectInherit\", \"None\", \"Allow\")",
            "    $allRestrictedApplicationPackagesAccessRule = New-Object System.Security.AccessControl.FileSystemAccessRule([System.Security.Principal.SecurityIdentifier]::new(\"S-1-15-2-2\"), \"ReadAndExecute\", \"ContainerInherit,ObjectInherit\", \"None\", \"Allow\")",
            "    $accessControlList.SetAccessRule($allApplicationPackagesAccessRule)",
            "    $accessControlList.SetAccessRule($allRestrictedApplicationPackagesAccessRule)",
            "    Set-Acl -AclObject $accessControlList $fontInstallDir",
            "}",
            "$registryRoot = if ($global) { \"HKLM\" } else { \"HKCU\" }",
            "$registryKey = \"${registryRoot}:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Fonts\"",
            "Get-ChildItem $dir -Filter 'PingFangSC-*.otf' | ForEach-Object {",
            "    $value = if ($global) { $_.Name } else { \"$fontInstallDir\\$($_.Name)\" }",
            "    New-ItemProperty -Path $registryKey -Name $_.Name.Replace($_.Extension, ' (TrueType)') -Value $value -Force | Out-Null",
            "    Copy-Item -LiteralPath $_.FullName -Destination $fontInstallDir",
            "}"
        ]
    },
    "pre_uninstall": [
        "# Use pre_uninstall to preserve the caller's scope: affected Scoop versions pass -Global $global instead of -Global:$global to Invoke-Installer.",
        "$fontInstallDir = if ($global) { \"$env:windir\\Fonts\" } else { \"$env:LOCALAPPDATA\\Microsoft\\Windows\\Fonts\" }",
        "$registryRoot = if ($global) { \"HKLM\" } else { \"HKCU\" }",
        "$registryKey = \"${registryRoot}:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Fonts\"",
        "Write-Host \"Removing $(if ($global) { 'global' } else { 'per-user' }) fonts from '$fontInstallDir' ($registryRoot).\"",
        "$fontNames = @($manifest.url | ForEach-Object { [System.IO.Path]::GetFileName(([uri]$_).AbsolutePath) })",
        "if ($fontNames.Count -ne 6 -or ($fontNames -notmatch '^PingFangSC-(Light|Medium|Regular|Semibold|Thin|Ultralight)\\.otf$')) { throw 'Invalid PingFang font list in manifest.' }",
        "# Validate every registration before changing any font in this package.",
        "$fonts = @(foreach ($fontName in $fontNames) {",
        "    $fontPath = Join-Path $fontInstallDir $fontName",
        "    $registryName = [System.IO.Path]::GetFileNameWithoutExtension($fontName) + ' (TrueType)'",
        "    $entry = $null",
        "    if (Test-Path -LiteralPath $registryKey -ErrorAction Stop) {",
        "        $entry = (Get-ItemProperty -LiteralPath $registryKey -ErrorAction Stop).PSObject.Properties[$registryName]",
        "    }",
        "    $expectedValue = if ($global) { $fontName } else { $fontPath }",
        "    if ($entry -and $entry.Value -ne $expectedValue) { throw \"Font registry entry '$registryName' points elsewhere; refusing to remove it.\" }",
        "    [pscustomobject]@{ Path = $fontPath; RegistryName = $registryName; Registered = [bool]$entry }",
        "})",
        "if (-not ('LzScoop.PingFangNative' -as [type])) {",
        "    Add-Type -TypeDefinition @'",
        "using System;",
        "using System.Runtime.InteropServices;",
        "namespace LzScoop {",
        "    public static class PingFangNative {",
        "        [DllImport(\"gdi32.dll\", CharSet = CharSet.Unicode, ExactSpelling = true)]",
        "        [return: MarshalAs(UnmanagedType.Bool)]",
        "        public static extern bool RemoveFontResourceExW(string name, uint flags, IntPtr reserved);",
        "        [DllImport(\"user32.dll\", ExactSpelling = true, SetLastError = true)]",
        "        [return: MarshalAs(UnmanagedType.Bool)]",
        "        public static extern bool SendNotifyMessageW(IntPtr hWnd, uint msg, UIntPtr wParam, IntPtr lParam);",
        "    }",
        "}",
        "'@ -ErrorAction Stop",
        "}",
        "# Unregister first so Windows will not reload these fonts after a restart.",
        "foreach ($font in $fonts) {",
        "    if ($font.Registered) { Remove-ItemProperty -LiteralPath $registryKey -Name $font.RegistryName -Force -ErrorAction Stop }",
        "}",
        "# Release session font resources; do not equate exclusive-open failure with inability to uninstall.",
        "# https://learn.microsoft.com/windows/win32/api/wingdi/nf-wingdi-removefontresourceexw",
        "foreach ($font in $fonts) {",
        "    while ([LzScoop.PingFangNative]::RemoveFontResourceExW($font.Path, 0, [IntPtr]::Zero)) { }",
        "}",
        "# HWND_BROADCAST / WM_FONTCHANGE; notify other applications without waiting for their handlers.",
        "if (-not [LzScoop.PingFangNative]::SendNotifyMessageW([IntPtr]0xffff, 0x001d, [UIntPtr]::Zero, [IntPtr]::Zero)) {",
        "    Write-Warning 'Could not broadcast the font change. Restart applications that cache fonts.'",
        "}",
        "$cleanupErrors = @()",
        "foreach ($font in $fonts) {",
        "    try {",
        "        if (Test-Path -LiteralPath $font.Path -ErrorAction Stop) {",
        "            Remove-Item -LiteralPath $font.Path -Force -ErrorAction Stop",
        "            if (Test-Path -LiteralPath $font.Path -ErrorAction Stop) { throw 'Font file is still present after deletion.' }",
        "        }",
        "    } catch {",
        "        $cleanupErrors += \"$($font.Path): $($_.Exception.Message)\"",
        "    }",
        "}",
        "if ($cleanupErrors.Count) {",
        "    throw (\"Font registrations have been removed, but file cleanup is incomplete. Close applications using these fonts, or restart Windows, then run 'scoop uninstall $(if ($global) { '-g ' })$app' again. Do not reinstall before cleanup. If it still fails, check file permissions. Details: \" + ($cleanupErrors -join '; '))",
        "}",
        "if ($cmd -eq \"uninstall\") {",
        "    Write-Host \"The 'PingFang SC' font files and registry entries have been removed. Restart applications that cache fonts.\" -Foreground Magenta",
        "}"
    ],
    "checkver": {
        "script": [
            "$tags = git ls-remote --tags https://github.com/ACT-02/PingFang-for-Windows.git",
            "$versions = foreach ($line in $tags) { if ($line -match 'refs/tags/([0-9]+\\.[0-9]+d[0-9]+e[0-9]+-static)$') { $matches[1] } }",
            "$versions | Sort-Object { [version](($_ -replace '-static$', '') -replace 'd', '.' -replace 'e', '.') } -Descending | Select-Object -First 1"
        ],
        "regex": "([0-9]+\\.[0-9]+d[0-9]+e[0-9]+-static)"
    },
    "autoupdate": {
        "url": [
            "https://raw.githubusercontent.com/ACT-02/PingFang-for-Windows/$version/PingFangSC-Light.otf",
            "https://raw.githubusercontent.com/ACT-02/PingFang-for-Windows/$version/PingFangSC-Medium.otf",
            "https://raw.githubusercontent.com/ACT-02/PingFang-for-Windows/$version/PingFangSC-Regular.otf",
            "https://raw.githubusercontent.com/ACT-02/PingFang-for-Windows/$version/PingFangSC-Semibold.otf",
            "https://raw.githubusercontent.com/ACT-02/PingFang-for-Windows/$version/PingFangSC-Thin.otf",
            "https://raw.githubusercontent.com/ACT-02/PingFang-for-Windows/$version/PingFangSC-Ultralight.otf"
        ]
    }
}
