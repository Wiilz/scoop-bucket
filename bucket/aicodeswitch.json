{
    "version": "5.1.3",
    "description": "AI编程工具模型接口本地化管理和快速切换工具",
    "homepage": "https://github.com/tangshuang/aicodeswitch",
    "license": "GPL-3.0",
    "depends": "nodejs",
    "installer": {
        "script": [
            "if (Get-Command pnpm -ErrorAction SilentlyContinue) {",
            "    pnpm add -g aicodeswitch",
            "} else {",
            "    npm install -g aicodeswitch",
            "}"
        ]
    },
    "uninstaller": {
        "script": [
            "if (Get-Command pnpm -ErrorAction SilentlyContinue) {",
            "    pnpm remove -g aicodeswitch",
            "} else {",
            "    npm uninstall -g aicodeswitch",
            "}"
        ]
    },
    "checkver": {
        "npm": "aicodeswitch"
    },
    "autoupdate": {
    }
}
